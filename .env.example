# =====================================================================
# Sözleşme Mevzuat Etki Analizi - örnek yapılandırma
# Bu dosyayı `.env` olarak kopyalayın ve değerleri doldurun.
# Gerçek anahtarları ASLA repoya koymayın. Sunucuda: chmod 600 .env
#
# ÖNEMLİ: Açıklamalar satır sonunda değil, ayrı satırlarda olmalı.
# systemd `EnvironmentFile` satır sonu yorumlarını değerin parçası sayar.
# =====================================================================

# --- Uygulama ---
APP_NAME=Sözleşme Mevzuat Etki Analizi
# dev | test | prod
APP_ENV=dev
ROOT_PATH=/sozlesme
HOST=127.0.0.1
PORT=8001
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
DATA_DIR=./data
LOG_DIR=./logs

# --- Azure AI Foundry ---
AZURE_OPENAI_BASE_URL=https://<resource>.services.ai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=
CHAT_MODEL=gpt-5.6-sol
# Boşsa vektör arama kapalıdır (sadece FTS5 kullanılır)
EMBEDDING_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
LLM_MAX_CONCURRENCY=4

# --- Sözleşme Kaynağı ---
# local | turkuaz | mock
CONTRACT_SOURCE=local
LOCAL_CONTRACTS_DIR=./sample_contracts
TURKUAZ_BASE_URL=
# api_key | bearer | oauth_client_credentials | basic
TURKUAZ_AUTH_MODE=api_key
TURKUAZ_API_KEY=
TURKUAZ_API_KEY_HEADER=x-api-key
TURKUAZ_BEARER_TOKEN=
TURKUAZ_TOKEN_URL=
TURKUAZ_CLIENT_ID=
TURKUAZ_CLIENT_SECRET=
TURKUAZ_SCOPE=
TURKUAZ_USERNAME=
TURKUAZ_PASSWORD=
TURKUAZ_TIMEOUT_SECONDS=60
TURKUAZ_VERIFY_SSL=true

# --- OCR (opsiyonel) ---
OCR_ENABLED=false
DOC_INTELLIGENCE_ENDPOINT=
DOC_INTELLIGENCE_KEY=

# --- Kimlik doğrulama ---
# none (sadece geliştirme; prod'da başlatılamaz) | basic | entra
AUTH_MODE=none
# kullanici:bcrypt_hash,kullanici2:bcrypt_hash
BASIC_AUTH_USERS=
# basic modda yönetici kullanıcı adları (virgülle)
BASIC_AUTH_ADMINS=
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=
# Boşsa tenant'taki herkes erişebilir
ALLOWED_GROUP_IDS=
# Yönetici rolünü veren Entra grup ID'leri (virgülle)
ADMIN_GROUP_IDS=
# Oturum çerezlerini imzalamak için uzun rastgele değer
# Üretmek için: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=

# --- Limitler ---
MAX_LEGISLATION_CHARS=200000
MAX_UPLOAD_MB=25
RATE_LIMIT_PER_MINUTE=60

# --- Ağ ---
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1
# Kurumsal CA sertifika dosyası (ör. /etc/ssl/certs/kurum-ca.pem)
REQUESTS_CA_BUNDLE=
SSL_CERT_FILE=
